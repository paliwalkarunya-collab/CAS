# CAS-SE Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# Application
ENVIRONMENT=development
DEBUG=false

# Database (PostgreSQL — organization provides their own in production)
DATABASE_URL=postgresql+asyncpg://cas_user:cas_pass@localhost:5432/cas_db

# Object Storage (MinIO / S3-compatible)
STORAGE_ADAPTER=minio
# For Azure/GCS/custom storage set a factory path instead of changing CAS-SE:
# STORAGE_ADAPTER=custom
# STORAGE_ADAPTER_FACTORY=company_cas.adapters:build_storage_adapter
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=cas-se-envelopes
OBJECT_STORAGE_USE_SSL=false
# For local development fallback:
LOCAL_STORAGE_PATH=./local_storage

# Key Management
KEY_SERVICE_ADAPTER=env
# For KMS/Vault/HSM set a factory path returning a KeyServiceAdapter:
# KEY_SERVICE_ADAPTER=custom
# KEY_SERVICE_ADAPTER_FACTORY=company_cas.adapters:build_key_service
CAS_KEK_CURRENT_VERSION=1
# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
CAS_KEK_V1=CHANGEME-generate-32-byte-base64-encoded-key
# Split-key demo only (JSON array; never put production key shares in .env):
# KEY_SERVICE_ADAPTER=split
# SPLIT_KEY_SHARES=["1-...","2-..."]
# SPLIT_KEY_THRESHOLD=2

# Authentication / JWT
IDENTITY_ADAPTER=builtin
# For OIDC/LDAP/SAML federation, disable the reference password routes and
# configure an adapter that verifies the organization's bearer token:
# IDENTITY_ADAPTER=external
# IDENTITY_ADAPTER_FACTORY=company_cas.adapters:build_identity_adapter
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGEME-generate-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# HMAC key for protected search indexes
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INDEX_HMAC_KEY=CHANGEME-generate-64-char-hex-hmac-key

# HMAC key for audit chain integrity (SEPARATE from index key)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_INTEGRITY_KEY=CHANGEME-generate-64-char-hex-audit-key

# Dedicated HMAC key for server-persisted ML job manifests (not returned to clients)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MANIFEST_SIGNING_KEY=CHANGEME-generate-64-char-hex-manifest-key

# OPA
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=cas_se/access
OPA_TIMEOUT_SECONDS=3.0

# Redis / Celery Worker
REDIS_URL=redis://localhost:6379/0

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Upload limits
MAX_UPLOAD_BYTES=10485760
