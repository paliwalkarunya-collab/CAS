# ==============================================================================
# CAS-SE (Cryptographically Audited Storage & Secure Evaluation) .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Keep environment templates tracked
!.env.example
!.env.template

# Cryptographic Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
secrets/

# ------------------------------------------------------------------------------
# Databases, Local Storage & Runtime Data
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
cas_dev.db

# Local envelope/object storage emulation
local_storage/
backend/local_storage/
uploads/
media/
minio_data/
.minio.sys/

# Redis dumps
dump.rdb

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
.hypothesis/
.tox/
.nox/

# Linters, Type Checkers & Static Analysis
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# Celery / Workers
celerybeat-schedule*
celerybeat.pid

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# Frontend / Node / TypeScript / Vite
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/
jspm_packages/
web_modules/

# Build artifacts
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
frontend/.next/
.next/
out/

# Vite & build caches
.vite/
frontend/.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Playwright & E2E Testing
test-results/
frontend/test-results/
playwright-report/
frontend/playwright-report/
blob-report/
frontend/blob-report/
playwright/.cache/
frontend/playwright/.cache/

# ------------------------------------------------------------------------------
# Logs & Process IDs
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
docker-compose.override.yml
.docker/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml

# Microsoft Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
.*.sw[a-p]
\#*\#
.#*

# ------------------------------------------------------------------------------
# Temporary & Backup Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
